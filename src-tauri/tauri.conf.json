{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shieldr",
  "version": "0.1.0",
  "identifier": "com.ahmedtrooper.shieldr",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shieldr",
        "label": "main",
        "width": 920,
        "height": 650,
        "minWidth": 300,
        "minHeight": 400,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "center": true,
        "visible": false
      },
      {
        "title": "Shieldr",
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 360,
        "height": 380,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "center": true,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3ODM5N0U2OTBCMTU4QQpSV1NLRlF0cGZqbDRCeXF5TWFkU202Y0J4RDdlUVVxd0VyVDJsTlY2UVFCbWh5ZnJ0ZXZvS0FvTwo=",
      "endpoints": [
        "https://github.com/AhmedTrooper/Shieldr/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
